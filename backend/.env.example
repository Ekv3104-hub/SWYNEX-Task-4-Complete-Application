PORT=3000
NODE_ENV=development

# Database configuration:
# For production on Supabase, provide the connection string.
# When DATABASE_URL is empty, FoodQueue defaults to local SQLite persistence in backend/data/foodqueue.db.
DATABASE_URL=
PGSSL=require

# Supabase Auth configuration:
# Public URL and anon key for Supabase client:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# JWT verification:
# - For Supabase HS256 JWTs: provide SUPABASE_JWT_SECRET from Supabase Settings -> API -> JWT Settings.
# - For Supabase RS256/ES256 asymmetric JWTs: SUPABASE_URL will be used to fetch the JWKS public keys.
SUPABASE_JWT_SECRET=your-jwt-secret

# Owner initial bootstrap secret:
# A secure, high-entropy secret used once via POST /api/auth/bootstrap-owner to elevate the first canteen owner.
OWNER_BOOTSTRAP_SECRET=change-this-to-a-strong-random-secret

# CORS origins:
# Comma-separated list of allowed frontend domains in production.
# Wildcards are rejected. Unapproved origins will not receive CORS headers.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Local demo authentication mode:
# Set to 'demo' for quick local offline development without Supabase.
# In production (NODE_ENV=production), demo auth is strictly blocked at the middleware layer.
AUTH_MODE=demo
